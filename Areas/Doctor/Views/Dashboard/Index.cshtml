@model QuanLyBenhVien.Models.ViewModels.DoctorDashboardViewModel
@using Microsoft.AspNetCore.Html

@{
    Layout = "~/Views/Shared/_DoctorLayout.cshtml";
    ViewData["Title"] = "Bảng điều khiển";

    var header = new PageHeaderViewModel
    {
        Title = "Bảng điều khiển",
        Subtitle = $"Xin chào, {FormatDoctorName(Model.Doctor)} — {Model.Doctor.Department?.TenKhoa}"
    };

    var tomorrow = DateTime.Today.AddDays(1);
    var longWait = Model.LongestWaitMinutes.HasValue && Model.LongestWaitMinutes.Value > 30;
}

@Html.AntiForgeryToken()

<partial name="_PageHeader" model="header" />

<!-- 4 thẻ hành động - snapshot tại thời điểm tải trang; số liệu chi tiết bên
     dưới (hàng đợi, cần xử lý) tự cập nhật qua SignalR. -->
<div class="grid grid-cols-1 sm:grid-cols-2 xl:grid-cols-4 gap-unit-md mb-unit-lg">
    <a href="#queue-section" class="bg-surface-container-lowest border border-outline-variant p-unit-md rounded-xl shadow-sm hover:border-primary transition-colors flex items-center gap-unit-md">
        <span class="material-symbols-outlined text-[32px] text-primary">patient_list</span>
        <div class="min-w-0">
            <span class="text-caption text-on-surface-variant block">Ca khám hôm nay</span>
            <strong class="text-title-lg text-on-surface block">@Model.TodayTotal ca</strong>
            <span class="text-caption text-on-surface-variant">@Model.TodayCompleted đã khám · @Model.TodayWaiting đang chờ</span>
        </div>
    </a>

    <a href="#queue-section" class="bg-surface-container-lowest border @(longWait ? "border-tertiary" : "border-outline-variant") p-unit-md rounded-xl shadow-sm hover:border-primary transition-colors flex items-center gap-unit-md">
        <span class="material-symbols-outlined text-[32px] @(longWait ? "text-tertiary" : "text-primary")">hourglass_top</span>
        <div class="min-w-0">
            <span class="text-caption text-on-surface-variant block">Đang chờ khám</span>
            <strong class="text-title-lg @(longWait ? "text-tertiary" : "text-on-surface") block">@Model.TodayWaiting bệnh nhân</strong>
            <span class="text-caption @(longWait ? "text-tertiary font-semibold" : "text-on-surface-variant")">
                @(Model.LongestWaitMinutes.HasValue ? $"Chờ lâu nhất: {Model.LongestWaitMinutes} phút" : "Chưa có ai chờ")
            </span>
        </div>
    </a>

    <a href="/Doctor/Queue?date=@tomorrow.ToString("yyyy-MM-dd")" class="bg-surface-container-lowest border border-outline-variant p-unit-md rounded-xl shadow-sm hover:border-primary transition-colors flex items-center gap-unit-md">
        <span class="material-symbols-outlined text-[32px] text-primary">event_upcoming</span>
        <div class="min-w-0">
            <span class="text-caption text-on-surface-variant block">Lịch ngày mai</span>
            <strong class="text-title-lg text-on-surface block">@Model.TomorrowTotal ca hẹn</strong>
            <span class="text-caption text-on-surface-variant">@tomorrow.ToString("dd/MM/yyyy")</span>
        </div>
    </a>

    <a href="/Doctor/Dashboard/Incomplete" class="bg-surface-container-lowest border @(Model.IncompleteRecordsCount > 0 ? "border-error" : "border-outline-variant") p-unit-md rounded-xl shadow-sm hover:border-primary transition-colors flex items-center gap-unit-md">
        <span class="material-symbols-outlined text-[32px] @(Model.IncompleteRecordsCount > 0 ? "text-error" : "text-primary")">fact_check</span>
        <div class="min-w-0">
            <span class="text-caption text-on-surface-variant block">Hồ sơ chưa hoàn thiện</span>
            <strong class="text-title-lg @(Model.IncompleteRecordsCount > 0 ? "text-error" : "text-on-surface") block">@Model.IncompleteRecordsCount hồ sơ</strong>
            <span class="text-caption text-on-surface-variant">30 ngày gần nhất</span>
        </div>
    </a>
</div>

<!-- Bố cục 2 cột: trái ~65% hàng đợi, phải ~35% cần xử lý + lịch tuần -->
<div class="flex flex-col gap-unit-lg xl:grid xl:grid-cols-[minmax(0,65fr)_minmax(0,35fr)] xl:items-start xl:gap-unit-lg">
    <div id="queue-section">
        <partial name="_QueueSection" model="Model" />
    </div>

    <div class="flex flex-col gap-unit-lg min-w-0">
        <div id="action-required-section">
            <partial name="_ActionRequiredSection" model="Model" />
        </div>

        <!-- Sắp có - tĩnh, không nằm trong vòng làm mới SignalR vì không có
             dữ liệu thật đứng sau (xem mục Backlog trong plan). -->
        <div class="bg-surface-container-lowest border border-outline-variant rounded-xl p-unit-md shadow-sm">
            <h4 class="font-label-md text-label-md text-on-surface-variant uppercase tracking-wider mb-unit-sm">Sắp có</h4>
            <ul class="space-y-2 text-body-md text-on-surface-variant">
                <li class="flex items-center gap-2"><span class="material-symbols-outlined text-[18px] text-outline">biotech</span> Kết quả CLS mới về / chờ kết luận</li>
                <li class="flex items-center gap-2"><span class="material-symbols-outlined text-[18px] text-outline">groups</span> Lời mời hội chẩn</li>
                <li class="flex items-center gap-2"><span class="material-symbols-outlined text-[18px] text-outline">local_pharmacy</span> Đơn thuốc bị dược sĩ phản hồi</li>
            </ul>
        </div>

        <partial name="_WeekSchedule" model="Model.Week" />
    </div>
</div>

@section Scripts {
    <script>
        function antiForgeryFormData() {
            const fd = new FormData();
            const token = document.querySelector('input[name="__RequestVerificationToken"]');
            if (token) fd.append('__RequestVerificationToken', token.value);
            return fd;
        }

        function refreshQueueSection() {
            fetch('/Doctor/Dashboard/QueueSection')
                .then(function (r) { return r.text(); })
                .then(function (html) {
                    const el = document.getElementById('queue-section');
                    if (el) el.innerHTML = html;
                })
                .catch(function (err) { console.error('Không thể làm mới hàng đợi:', err); });
        }

        function refreshActionRequiredSection() {
            fetch('/Doctor/Dashboard/ActionRequiredSection')
                .then(function (r) { return r.text(); })
                .then(function (html) {
                    const el = document.getElementById('action-required-section');
                    if (el) el.innerHTML = html;
                })
                .catch(function (err) { console.error('Không thể làm mới danh sách cần xử lý:', err); });
        }

        // "Gọi bệnh nhân tiếp theo" - phát ra từ _QueueSection, xử lý ở đây để
        // dùng chung antiForgeryFormData() và luồng chuyển trang.
        function callNextPatient(button) {
            button.disabled = true;
            fetch('/Doctor/Dashboard/CallNextPatient', { method: 'POST', body: antiForgeryFormData() })
                .then(function (r) { return r.json(); })
                .then(function (data) {
                    if (data.success) {
                        window.location.href = data.redirectUrl;
                    } else {
                        button.disabled = false;
                        if (typeof showGlobalToast === 'function') {
                            showGlobalToast('Không thể gọi bệnh nhân', data.message || 'Vui lòng thử lại.', 'warning');
                        } else {
                            alert(data.message || 'Vui lòng thử lại.');
                        }
                        refreshQueueSection();
                    }
                })
                .catch(function () {
                    button.disabled = false;
                });
        }

        // Lắng nghe kết nối SignalR dùng chung do _DoctorLayout thiết lập.
        (function attachDashboardHubListeners() {
            if (!window.doctorHubConnection) {
                // Layout vừa mới bắt đầu kết nối - thử lại sau một nhịp ngắn.
                setTimeout(attachDashboardHubListeners, 300);
                return;
            }
            window.doctorHubConnection.on('QueueUpdated', refreshQueueSection);
            window.doctorHubConnection.on('ActionRequiredUpdated', refreshActionRequiredSection);
        })();
    </script>
}
