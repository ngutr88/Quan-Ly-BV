@model QuanLyBenhVien.Models.GoodsReceipt
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <title>Biên bản kiểm nhập @Model.MaPhieu</title>
    <style>
        @@page { size: A4; margin: 15mm 14mm; }
        * { box-sizing: border-box; }
        body { font-family: "Times New Roman", Times, serif; font-size: 13px; color: #111; margin: 0; }
        .print-toolbar { text-align: center; padding: 10px; background: #f0f0f0; }
        .print-toolbar button { padding: 8px 18px; font-size: 14px; cursor: pointer; }
        @@media print { .print-toolbar { display: none; } }

        .org-info { font-weight: bold; text-transform: uppercase; text-align: center; }
        .doc-title { text-align: center; margin: 14px 0 4px; }
        .doc-title h1 { font-size: 20px; margin: 0; text-transform: uppercase; letter-spacing: 1px; }
        .doc-sub { text-align: center; font-style: italic; margin-bottom: 14px; }
        p { margin: 4px 0; line-height: 1.5; }
        table.items { width: 100%; border-collapse: collapse; margin: 10px 0; }
        table.items th, table.items td { border: 1px solid #333; padding: 5px 6px; font-size: 12.5px; }
        table.items th { background: #eee; text-align: center; }
        table.items td.num { text-align: right; }
        table.items td.center { text-align: center; }
        .conclusion { margin: 14px 0; }
        .signatures { display: grid; grid-template-columns: repeat(4, 1fr); gap: 8px; text-align: center; margin-top: 30px; }
        .signatures .sig-line { margin-top: 60px; font-weight: bold; }
        .signatures .role { font-weight: bold; }
        .signatures .hint { font-style: italic; font-size: 11.5px; }
    </style>
</head>
<body>
    <div class="print-toolbar">
        <button onclick="window.print()">In biên bản</button>
    </div>

    <div class="org-info">
        BỆNH VIỆN MEDIFLOW HMS<br />
        <span style="font-weight:normal;">Hội đồng kiểm nhập thuốc</span>
    </div>

    <div class="doc-title">
        <h1>Biên bản kiểm nhập thuốc</h1>
    </div>
    <div class="doc-sub">
        Kèm theo phiếu nhập kho số <strong>@Model.MaPhieu</strong> ngày @Model.NgayNhap.ToString("dd/MM/yyyy")
    </div>

    <p>
        Hôm nay, ngày @DateTime.Now.ToString("dd") tháng @DateTime.Now.ToString("MM") năm @DateTime.Now.ToString("yyyy"),
        Hội đồng kiểm nhập thuốc của Bệnh viện MediFlow HMS đã tiến hành kiểm tra, đối chiếu số lượng, chất lượng,
        hạn sử dụng và bao bì đóng gói của lô hàng nhập kho theo phiếu nhập kho số <strong>@Model.MaPhieu</strong>,
        nhà cung cấp <strong>@(Model.NhaCungCap?.TenNhaCungCap ?? "--")</strong>,
        hóa đơn số <strong>@(Model.SoHoaDonNCC ?? "--")</strong> ngày @(Model.NgayHoaDon?.ToString("dd/MM/yyyy") ?? "--").
    </p>

    <table class="items">
        <thead>
            <tr>
                <th style="width:26px;">STT</th>
                <th>Tên thuốc</th>
                <th>Số lô</th>
                <th>Hạn dùng</th>
                <th>Số lượng nhập</th>
                <th>Quy cách đóng gói</th>
                <th>Tình trạng bao bì</th>
                <th>Kết quả kiểm tra</th>
            </tr>
        </thead>
        <tbody>
            @{ var i = 1; }
            @foreach (var d in Model.ChiTiet)
            {
                <tr>
                    <td class="center">@i</td>
                    <td>@d.Medicine.TenThuoc<br /><span style="font-size:11px; font-style:italic;">@d.Medicine.HoatChat</span></td>
                    <td class="center">@d.SoLo</td>
                    <td class="center">@d.HanSuDung.ToString("dd/MM/yyyy")</td>
                    <td class="num">@d.SoLuong @d.Medicine.DonViTinh</td>
                    <td class="center">@(d.Medicine.QuyCachDongGoi ?? "--")</td>
                    <td class="center">Nguyên vẹn</td>
                    <td class="center"><strong>Đạt</strong></td>
                </tr>
                i++;
            }
        </tbody>
    </table>

    <div class="conclusion">
        <p><strong>Kết luận:</strong> Hàng hóa kiểm nhập đúng chủng loại, số lượng, quy cách và hạn sử dụng như phiếu nhập kho đã lập.
        Đủ điều kiện nhập kho và đưa vào sử dụng.</p>
    </div>

    <div class="signatures">
        <div>
            <div class="role">Chủ tịch hội đồng</div>
            <div class="hint">(Ký, ghi rõ họ tên)</div>
            <div class="sig-line">@Model.NguoiDuyet?.HoTen</div>
        </div>
        <div>
            <div class="role">Ủy viên</div>
            <div class="hint">(Ký, ghi rõ họ tên)</div>
            <div class="sig-line">&nbsp;</div>
        </div>
        <div>
            <div class="role">Thủ kho</div>
            <div class="hint">(Ký, ghi rõ họ tên)</div>
            <div class="sig-line">&nbsp;</div>
        </div>
        <div>
            <div class="role">Đại diện đơn vị giao hàng</div>
            <div class="hint">(Ký, ghi rõ họ tên)</div>
            <div class="sig-line">@(Model.NguoiGiaoHang ?? "")</div>
        </div>
    </div>
</body>
</html>
