@model IEnumerable<QuanLyBenhVien.Models.GoodsReceipt>

@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = "Phiếu nhập kho";
    var trangThaiFilter = ViewBag.TrangThaiFilter as string;

    string StatusBadge(string trangThai) => trangThai switch
    {
        "Nhap" => "bg-surface-container-high text-on-surface-variant",
        "ChoDuyet" => "bg-tertiary-fixed/30 text-on-tertiary-fixed-variant",
        "DaDuyet" => "bg-secondary-container/20 text-on-secondary-container",
        "TuChoi" => "bg-error-container text-error",
        "DaHuy" => "bg-surface-container-high text-outline line-through",
        _ => "bg-surface-container-high text-on-surface-variant"
    };

    string StatusLabel(string trangThai) => trangThai switch
    {
        "Nhap" => "Nháp",
        "ChoDuyet" => "Chờ duyệt",
        "DaDuyet" => "Đã duyệt",
        "TuChoi" => "Từ chối",
        "DaHuy" => "Đã hủy",
        _ => trangThai
    };
}

<div class="mb-unit-lg flex justify-between items-end flex-wrap gap-unit-sm">
    <div>
        <a href="/Admin/Medicines" class="inline-flex items-center gap-1 text-primary hover:underline text-body-md font-semibold mb-unit-sm">
            <span class="material-symbols-outlined text-[18px]">arrow_back</span> Quay lại kho dược phẩm
        </a>
        <h2 class="font-headline-lg text-headline-lg text-on-surface">Phiếu nhập kho</h2>
        <p class="text-body-md text-on-surface-variant">Quản lý phiếu nhập kho theo quy trình Nháp → Chờ duyệt → Đã duyệt.</p>
    </div>
    <a href="/Admin/Medicines/ReceiveBatch" class="hms-btn hms-btn-primary">
        <span class="material-symbols-outlined">add</span> Lập phiếu nhập kho
    </a>
</div>

<div class="hms-toolbar mb-unit-md">
    <div class="flex flex-wrap gap-unit-sm">
        @{
            var filters = new (string Value, string Label)[]
            {
                (null, "Tất cả"), ("Nhap", "Nháp"), ("ChoDuyet", "Chờ duyệt"),
                ("DaDuyet", "Đã duyệt"), ("TuChoi", "Từ chối"), ("DaHuy", "Đã hủy")
            };
        }
        @foreach (var f in filters)
        {
            var active = trangThaiFilter == f.Value;
            <a href="@(f.Value == null ? "/Admin/Medicines/Receipts" : $"/Admin/Medicines/Receipts?trangThai={f.Value}")"
               class="px-3 py-1.5 rounded-full text-label-md font-semibold @(active ? "bg-primary text-white" : "bg-surface-container-high text-on-surface-variant hover:bg-surface-container-highest")">
                @f.Label
            </a>
        }
    </div>
</div>

<div class="bg-surface-container-lowest border border-outline-variant rounded-xl overflow-hidden shadow-sm">
    <div class="hms-table-scroll overflow-x-auto" role="region" aria-label="Danh sách phiếu nhập kho" tabindex="0">
        <table class="w-full text-left">
            <thead>
                <tr class="bg-surface-container-low text-on-surface-variant font-label-md text-[12px] uppercase">
                    <th class="px-unit-md py-3">Mã phiếu</th>
                    <th class="px-unit-md py-3">Ngày nhập</th>
                    <th class="px-unit-md py-3">Nhà cung cấp</th>
                    <th class="px-unit-md py-3">Người tạo</th>
                    <th class="px-unit-md py-3">Tổng thanh toán</th>
                    <th class="px-unit-md py-3">Trạng thái</th>
                    <th class="px-unit-md py-3"></th>
                </tr>
            </thead>
            <tbody class="divide-y divide-outline-variant text-body-md">
                @if (!Model.Any())
                {
                    <tr><td colspan="7" class="px-unit-md py-8 text-center text-on-surface-variant">Chưa có phiếu nhập kho nào.</td></tr>
                }
                else
                {
                    @foreach (var r in Model)
                    {
                        <tr class="hover:bg-surface-container-low transition-colors">
                            <td class="px-unit-md py-4 font-mono font-bold text-primary">@r.MaPhieu</td>
                            <td class="px-unit-md py-4">@r.NgayNhap.ToString("dd/MM/yyyy")</td>
                            <td class="px-unit-md py-4">@(r.NhaCungCap?.TenNhaCungCap ?? "--")</td>
                            <td class="px-unit-md py-4">@r.NguoiTao?.HoTen</td>
                            <td class="px-unit-md py-4 font-semibold">@r.TongThanhToan.ToString("N0") đ</td>
                            <td class="px-unit-md py-4">
                                <span class="px-2.5 py-0.5 rounded-full text-[11px] font-bold uppercase tracking-tight @StatusBadge(r.TrangThai)">@StatusLabel(r.TrangThai)</span>
                            </td>
                            <td class="px-unit-md py-4 text-right">
                                <a href="/Admin/Medicines/ReceiptDetails/@r.Id" class="text-primary hover:underline font-semibold">Xem</a>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>
