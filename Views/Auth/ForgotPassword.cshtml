@{
    Layout = "_Layout";
    ViewData["Title"] = "Khôi phục mật khẩu";
}

<div class="bg-surface min-h-screen flex flex-col items-center justify-center p-margin-mobile">
    <main class="w-full max-w-[480px] flex flex-col items-center py-unit-xl">
        <header class="text-center mb-unit-lg">
            <div class="inline-flex items-center justify-center bg-primary rounded-full w-14 h-14 mb-unit-md text-white">
                <span class="material-symbols-outlined text-headline-lg">lock_reset</span>
            </div>
            <h1 class="font-headline-md text-primary font-bold tracking-tight">Khôi phục mật khẩu</h1>
            <p class="font-body-md text-on-surface-variant mt-unit-sm">
                Nhập địa chỉ Email hoặc Số điện thoại liên kết với tài khoản để nhận mã xác nhận.
            </p>
        </header>

        @await Html.PartialAsync("_PasswordResetStepIndicator", 1)

        <div class="glass-card w-full rounded-xl p-unit-lg shadow-sm">
            @if (ViewBag.Blocked == true)
            {
                <div class="bg-error-container text-error rounded-lg p-unit-md text-body-sm font-medium">
                    Vui lòng thử lại sau.
                </div>
            }
            else
            {
                <form id="forgot-password-form" action="/Auth/ForgotPassword" method="POST" class="space-y-unit-md" novalidate>
                    @Html.AntiForgeryToken()
                    <div class="space-y-unit-xs">
                        <label class="block text-caption font-semibold text-on-surface-variant" for="identifier">Email / Số điện thoại đăng ký</label>
                        <div class="relative">
                            <span class="absolute inset-y-0 left-0 pl-3 flex items-center text-outline">
                                <span class="material-symbols-outlined">alternate_email</span>
                            </span>
                            <input class="w-full pl-10 pr-4 py-2.5 bg-surface border border-outline-variant rounded-lg font-body-md input-focus"
                                   id="identifier" name="identifier" placeholder="example@mail.com hoặc 090..." type="text" autocomplete="username" />
                        </div>
                        <p id="identifier-error" class="text-caption text-error hidden"></p>
                        <p class="text-caption text-on-surface-variant">Dùng email hoặc số điện thoại bạn đã đăng ký khi tạo tài khoản.</p>
                    </div>

                    @if (ViewBag.RequireCaptcha == true)
                    {
                        <div class="space-y-unit-xs">
                            <label class="block text-caption font-semibold text-on-surface-variant" for="captchaAnswer">Xác nhận: @ViewBag.CaptchaA + @ViewBag.CaptchaB = ?</label>
                            <input class="w-full px-4 py-2.5 bg-surface border border-outline-variant rounded-lg font-body-md input-focus"
                                   id="captchaAnswer" name="captchaAnswer" placeholder="Nhập kết quả phép tính" inputmode="numeric" required />
                        </div>
                    }

                    <button id="forgot-password-submit" class="w-full bg-primary text-on-primary font-body-lg font-semibold py-3 rounded-lg hover:bg-primary-container transition-all active:scale-[0.98] flex items-center justify-center gap-unit-sm shadow-md" type="submit">
                        <span id="forgot-password-submit-label">Gửi mã xác nhận</span>
                        <span class="material-symbols-outlined">send_and_archive</span>
                    </button>
                </form>
            }

            <div class="mt-unit-lg pt-unit-md border-t border-outline-variant text-center space-y-2">
                <p class="text-body-md text-on-surface-variant">
                    Nhớ ra mật khẩu?
                    <a class="text-primary font-bold hover:underline" href="/Auth/Login">Quay lại Đăng nhập</a>
                </p>
                <p class="text-caption text-on-surface-variant">
                    Không còn dùng email/SĐT đã đăng ký? Liên hệ hotline <strong>1900-6900</strong> hoặc đến quầy tiếp đón kèm giấy tờ tùy thân.
                </p>
            </div>
        </div>
    </main>
</div>

@section Scripts {
<script>
    (function () {
        const form = document.getElementById('forgot-password-form');
        if (!form) return;
        const identifier = document.getElementById('identifier');
        const identifierError = document.getElementById('identifier-error');
        const submitButton = document.getElementById('forgot-password-submit');
        const submitLabel = document.getElementById('forgot-password-submit-label');
        const phonePattern = /^0(3[2-9]|5[5-9]|7[06-9]|8[1-9]|9[0-9])\d{7}$/;

        function showError(message) {
            identifierError.textContent = message;
            identifierError.classList.remove('hidden');
            identifier.classList.add('border-error');
        }

        function clearError() {
            identifierError.textContent = '';
            identifierError.classList.add('hidden');
            identifier.classList.remove('border-error');
        }

        function validate() {
            const value = identifier.value.trim();
            if (!value) {
                showError('Vui lòng nhập email hoặc số điện thoại đã đăng ký');
                return false;
            }
            if (value.includes('@@')) {
                if (!/^[^\s@@]+@@[^\s@@]+\.[^\s@@]+$/.test(value)) {
                    showError('Email không hợp lệ');
                    return false;
                }
            } else if (!phonePattern.test(value)) {
                showError('Số điện thoại không hợp lệ');
                return false;
            }
            clearError();
            return true;
        }

        identifier.addEventListener('input', clearError);

        form.addEventListener('submit', function (event) {
            if (!validate()) {
                event.preventDefault();
                identifier.focus();
                return;
            }
            submitButton.disabled = true;
            submitButton.classList.add('opacity-70', 'cursor-not-allowed');
            submitLabel.textContent = 'Đang gửi...';
        });
    })();
</script>
}
