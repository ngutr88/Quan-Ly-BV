@{
    Layout = "_Layout";
    ViewData["Title"] = "Đặt mật khẩu mới";
}

<div class="bg-surface min-h-screen flex flex-col items-center justify-center p-margin-mobile">
    <main class="w-full max-w-[480px] flex flex-col items-center py-unit-xl">
        <header class="text-center mb-unit-lg">
            <div class="inline-flex items-center justify-center bg-primary rounded-full w-14 h-14 mb-unit-md text-white">
                <span class="material-symbols-outlined text-headline-lg">password</span>
            </div>
            <h1 class="font-headline-md text-primary font-bold tracking-tight">Đặt mật khẩu mới</h1>
            <p class="font-body-md text-on-surface-variant mt-unit-sm">
                Chọn một mật khẩu mới, khác với mật khẩu hiện tại của bạn.
            </p>
        </header>

        @await Html.PartialAsync("_PasswordResetStepIndicator", 3)

        <div class="glass-card w-full rounded-xl p-unit-lg shadow-sm">
            <form id="set-password-form" action="/Auth/SetNewPassword" method="POST" class="space-y-unit-md" novalidate>
                @Html.AntiForgeryToken()
                <input type="hidden" name="token" value="@ViewBag.Token" />

                <div class="space-y-unit-xs">
                    <label class="block text-caption font-semibold text-on-surface-variant" for="newPassword">Mật khẩu mới</label>
                    <div class="relative">
                        <input class="w-full px-4 pr-11 py-2.5 bg-surface border border-outline-variant rounded-lg font-body-md input-focus"
                               id="newPassword" name="newPassword" type="password" autocomplete="new-password" />
                        <button type="button" class="absolute inset-y-0 right-0 pr-3 flex items-center text-on-surface-variant" data-toggle-for="newPassword" aria-label="Hiện mật khẩu">
                            <span class="material-symbols-outlined">visibility</span>
                        </button>
                    </div>
                </div>

                <partial name="_PasswordStrengthField" model='new QuanLyBenhVien.Models.ViewModels.PasswordStrengthFieldViewModel { NewPasswordInputId = "newPassword", ConfirmPasswordInputId = "confirmPassword" }' />

                <div class="space-y-unit-xs">
                    <label class="block text-caption font-semibold text-on-surface-variant" for="confirmPassword">Xác nhận mật khẩu mới</label>
                    <div class="relative">
                        <input class="w-full px-4 pr-11 py-2.5 bg-surface border border-outline-variant rounded-lg font-body-md input-focus"
                               id="confirmPassword" name="confirmPassword" type="password" autocomplete="new-password" />
                        <button type="button" class="absolute inset-y-0 right-0 pr-3 flex items-center text-on-surface-variant" data-toggle-for="confirmPassword" aria-label="Hiện mật khẩu">
                            <span class="material-symbols-outlined">visibility</span>
                        </button>
                    </div>
                    <p id="confirm-error" class="text-caption text-error hidden"></p>
                </div>

                <button id="set-password-submit" class="w-full bg-primary text-on-primary font-body-lg font-semibold py-3 rounded-lg hover:bg-primary-container transition-all active:scale-[0.98] flex items-center justify-center gap-unit-sm shadow-md" type="submit">
                    <span id="set-password-submit-label">Đặt mật khẩu mới</span>
                    <span class="material-symbols-outlined">check_circle</span>
                </button>
            </form>
        </div>
    </main>
</div>

@section Scripts {
<script>
    (function () {
        document.querySelectorAll('[data-toggle-for]').forEach(button => {
            button.addEventListener('click', () => {
                const input = document.getElementById(button.getAttribute('data-toggle-for'));
                const icon = button.querySelector('.material-symbols-outlined');
                const show = input.type === 'password';
                input.type = show ? 'text' : 'password';
                icon.textContent = show ? 'visibility_off' : 'visibility';
            });
        });

        const newPassword = document.getElementById('newPassword');
        const confirmPassword = document.getElementById('confirmPassword');
        const confirmError = document.getElementById('confirm-error');

        document.getElementById('set-password-form').addEventListener('submit', function (event) {
            confirmError.classList.add('hidden');
            if (!window.isPasswordPolicyCompliant_newPassword(newPassword.value)) {
                event.preventDefault();
                confirmError.textContent = 'Mật khẩu chưa đáp ứng đủ yêu cầu tối thiểu.';
                confirmError.classList.remove('hidden');
                return;
            }
            if (newPassword.value !== confirmPassword.value) {
                event.preventDefault();
                confirmError.textContent = 'Xác nhận mật khẩu không khớp.';
                confirmError.classList.remove('hidden');
                return;
            }
            const submitButton = document.getElementById('set-password-submit');
            const submitLabel = document.getElementById('set-password-submit-label');
            submitButton.disabled = true;
            submitButton.classList.add('opacity-70', 'cursor-not-allowed');
            submitLabel.textContent = 'Đang xử lý...';
        });
    })();
</script>
}
