@{
    Layout = "_Layout";
    ViewData["Title"] = "Đặt lại mật khẩu thành công";
}

<div class="bg-surface min-h-screen flex flex-col items-center justify-center p-margin-mobile">
    <main class="w-full max-w-lg flex flex-col items-center text-center py-unit-xl">
        <div class="inline-flex items-center justify-center bg-secondary-container text-secondary rounded-full w-20 h-20 mb-unit-lg shadow-inner">
            <span class="material-symbols-outlined text-[48px]" style="font-variation-settings: 'FILL' 1;">check_circle</span>
        </div>

        <h1 class="font-headline-lg text-on-surface font-extrabold tracking-tight">Đặt lại mật khẩu thành công!</h1>
        <p class="font-body-md text-on-surface-variant mt-unit-sm max-w-sm mx-auto leading-relaxed">
            Mật khẩu của bạn đã được cập nhật. Vì lý do bảo mật, mọi phiên đăng nhập trước đó đã bị đăng xuất - vui lòng đăng nhập lại bằng mật khẩu mới.
        </p>

        <div class="mt-unit-xl w-full flex flex-col gap-unit-sm">
            <a href="/Auth/Login" class="w-full bg-primary text-on-primary font-body-lg font-semibold py-3 rounded-lg hover:bg-primary-container transition-all active:scale-[0.98] flex items-center justify-center gap-unit-sm shadow-md">
                <span class="material-symbols-outlined">login</span>
                <span>Về trang đăng nhập</span>
            </a>
        </div>
    </main>
</div>
