@{
    Layout = "_Layout";
    ViewData["Title"] = "Xác thực 2 lớp";
}

@section Styles {
<style>
    .verify-shell{min-height:100svh;display:grid;place-items:center;padding:2rem 1rem;background:radial-gradient(circle at 15% 10%,rgba(169,212,255,.2),transparent 30%),#f5f8fb;color:#102a43}.verify-card{width:min(100%,31rem);background:#fff;border:1px solid #d9e5ec;border-radius:1.15rem;padding:clamp(1.5rem,4vw,2.5rem);box-shadow:0 18px 42px rgba(14,47,83,.1);text-align:center}.verify-mark{display:grid;place-items:center;width:4rem;height:4rem;margin:0 auto 1.25rem;border-radius:1.15rem;background:#eaf3ff;color:#0b5cab}.verify-title{margin:0;font-size:clamp(1.7rem,4vw,2.15rem);letter-spacing:-.035em}.verify-copy{margin:.7rem 0 1.7rem;color:#627d98;line-height:1.65}.verify-label{display:block;margin-bottom:.55rem;color:#36566c;font-size:.82rem;font-weight:700}.verify-input{width:100%;height:4rem;border:1px solid #cbd8e3;border-radius:.8rem;color:#102a43;background:#fff;text-align:center;font-size:1.75rem;font-weight:700;letter-spacing:.55em;padding-left:.55em;transition:border-color .18s,box-shadow .18s}.verify-input:focus{border-color:#70a9e8;box-shadow:0 0 0 4px rgba(11,92,171,.1);outline:none}.verify-submit{width:100%;height:3.25rem;border:0;border-radius:.72rem;background:#0b5cab;color:#fff;font-weight:700;display:flex;align-items:center;justify-content:center;gap:.5rem;box-shadow:0 10px 22px rgba(11,92,171,.2);transition:transform .18s,background .18s;margin-top:1.35rem}.verify-submit:hover{background:#08457f;transform:translateY(-1px)}.verify-actions{border-top:1px solid #e6eef2;margin-top:1.35rem;padding-top:1.1rem;display:grid;gap:.7rem;color:#627d98;font-size:.8rem}.verify-actions button,.verify-actions a{color:#0b5cab;font-weight:700}.verify-security{display:flex;justify-content:center;align-items:center;gap:.35rem;color:#829ab1;font-size:.72rem;margin-top:1.2rem}.verify-security .material-symbols-outlined{font-size:1rem}
    @@media(prefers-reduced-motion:reduce){.verify-submit{transition:none}.verify-submit:hover{transform:none}}
</style>
}

<main class="verify-shell">
    <section class="verify-card" aria-labelledby="verify-title">
        <div class="verify-mark"><span class="material-symbols-outlined" style="font-size:2rem">shield</span></div>
        <h1 id="verify-title" class="verify-title">Xác thực 2 lớp</h1>
        <p class="verify-copy">Nhập mã 6 số từ ứng dụng authenticator trên điện thoại của bạn.</p>

        <form asp-controller="Auth" asp-action="VerifyTotp" method="post" id="totp-form">
            @Html.AntiForgeryToken()
            <label class="verify-label" for="code">Mã xác thực</label>
            <input class="verify-input" id="code" name="code" placeholder="••••••" maxlength="6" minlength="6"
                   pattern="[0-9]{6}" inputmode="numeric" type="text" autocomplete="one-time-code" autofocus
                   title="Vui lòng nhập đủ 6 chữ số" />
            <button class="verify-submit" type="submit"><span>Xác nhận</span><span class="material-symbols-outlined">verified</span></button>
        </form>

        <div class="verify-actions">
            <p><button type="button" onclick="toggleBackupCode()" id="backup-toggle">Dùng mã dự phòng thay thế</button></p>
            <a href="/Auth/Login">Quay lại đăng nhập</a>
        </div>
        <p class="verify-security"><span class="material-symbols-outlined">verified_user</span>Thông tin xác thực được bảo vệ</p>
    </section>
</main>

@section Scripts {
<script>
    const codeInput = document.getElementById('code');
    const backupCodeInput = document.getElementById('backupCodeInput');
    const backupToggle = document.getElementById('backup-toggle');
    let usingBackupCode = false;

    codeInput.addEventListener('input', () => { codeInput.value = codeInput.value.replace(/\D/g, '').slice(0, usingBackupCode ? 8 : 6); });

    function toggleBackupCode() {
        usingBackupCode = !usingBackupCode;
        if (usingBackupCode) {
            document.getElementById('verify-title').nextElementSibling.textContent = 'Nhập 1 mã dự phòng 8 số bạn đã lưu khi bật 2FA.';
            document.querySelector('.verify-label').textContent = 'Mã dự phòng';
            codeInput.name = 'backupCode';
            codeInput.maxLength = 8;
            codeInput.pattern = '[0-9]{8}';
            backupToggle.textContent = 'Dùng mã từ ứng dụng authenticator';
        } else {
            document.getElementById('verify-title').nextElementSibling.textContent = 'Nhập mã 6 số từ ứng dụng authenticator trên điện thoại của bạn.';
            document.querySelector('.verify-label').textContent = 'Mã xác thực';
            codeInput.name = 'code';
            codeInput.maxLength = 6;
            codeInput.pattern = '[0-9]{6}';
            backupToggle.textContent = 'Dùng mã dự phòng thay thế';
        }
        codeInput.value = '';
        codeInput.focus();
    }
</script>
}
