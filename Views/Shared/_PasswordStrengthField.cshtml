@model QuanLyBenhVien.Models.ViewModels.PasswordStrengthFieldViewModel
@{
    // Scope every generated id by the caller's input id so the partial can be
    // dropped onto a page more than once (or alongside another instance)
    // without colliding - the input ids are already unique per page anyway.
    var scope = Model.NewPasswordInputId;
}

<div class="space-y-1" data-password-strength-scope="@scope">
    <div class="h-1.5 w-full bg-surface-container-high rounded-full overflow-hidden">
        <div id="strength-bar-@scope" class="h-full w-0 transition-all"></div>
    </div>
    <p id="strength-label-@scope" class="text-caption text-on-surface-variant"></p>
    <ul class="text-caption text-on-surface-variant space-y-0.5 mt-1">
        <li id="rule-length-@scope" class="flex items-center gap-1"><span class="material-symbols-outlined text-[16px]">radio_button_unchecked</span> Tối thiểu 8 ký tự</li>
        <li id="rule-upper-@scope" class="flex items-center gap-1"><span class="material-symbols-outlined text-[16px]">radio_button_unchecked</span> Có chữ hoa</li>
        <li id="rule-lower-@scope" class="flex items-center gap-1"><span class="material-symbols-outlined text-[16px]">radio_button_unchecked</span> Có chữ thường</li>
        <li id="rule-digit-@scope" class="flex items-center gap-1"><span class="material-symbols-outlined text-[16px]">radio_button_unchecked</span> Có chữ số</li>
        <li id="rule-special-@scope" class="flex items-center gap-1 opacity-70"><span class="material-symbols-outlined text-[16px]">radio_button_unchecked</span> Có ký tự đặc biệt (khuyến khích)</li>
    </ul>
</div>

<script>
    // initPasswordStrengthField - one call per partial instance, keyed by the
    // same "scope" suffix used above for the element ids. Exposes
    // window.isPasswordPolicyCompliant_<scope>(value) so the enclosing form's
    // submit handler can reuse the exact same rule the checklist shows.
    (function () {
        var scope = @Html.Raw(Json.Serialize(scope));
        var newPasswordInput = document.getElementById(@Html.Raw(Json.Serialize(Model.NewPasswordInputId)));
        if (!newPasswordInput) return;

        var strengthBar = document.getElementById('strength-bar-' + scope);
        var strengthLabel = document.getElementById('strength-label-' + scope);
        var rules = {
            length: { el: document.getElementById('rule-length-' + scope), test: function (v) { return v.length >= 8; } },
            upper: { el: document.getElementById('rule-upper-' + scope), test: function (v) { return /[A-Z]/.test(v); } },
            lower: { el: document.getElementById('rule-lower-' + scope), test: function (v) { return /[a-z]/.test(v); } },
            digit: { el: document.getElementById('rule-digit-' + scope), test: function (v) { return /[0-9]/.test(v); } },
            special: { el: document.getElementById('rule-special-' + scope), test: function (v) { return /[^A-Za-z0-9]/.test(v); } }
        };

        function setRuleState(rule, passed) {
            var icon = rule.el.querySelector('.material-symbols-outlined');
            icon.textContent = passed ? 'check_circle' : 'radio_button_unchecked';
            rule.el.classList.toggle('text-secondary', passed);
        }

        function evaluateStrength() {
            var value = newPasswordInput.value;
            var passedCount = 0;
            Object.keys(rules).forEach(function (key) {
                var rule = rules[key];
                var passed = rule.test(value);
                setRuleState(rule, passed);
                if (passed) passedCount++;
            });

            var requiredPassed = ['length', 'upper', 'lower', 'digit'].filter(function (key) { return rules[key].test(value); }).length;
            var pct = value.length === 0 ? 0 : Math.round((passedCount / 5) * 100);
            strengthBar.style.width = pct + '%';

            var level = 'Yếu';
            var colorClass = 'bg-error';
            if (requiredPassed === 4 && passedCount === 5) { level = 'Mạnh'; colorClass = 'bg-secondary'; }
            else if (requiredPassed === 4) { level = 'Đạt yêu cầu'; colorClass = 'bg-tertiary'; }
            else if (requiredPassed >= 2) { level = 'Trung bình'; colorClass = 'bg-tertiary'; }

            strengthBar.className = 'h-full transition-all ' + colorClass;
            strengthLabel.textContent = value ? ('Độ mạnh: ' + level) : '';
        }

        window['isPasswordPolicyCompliant_' + scope] = function (value) {
            return rules.length.test(value) && rules.upper.test(value) && rules.lower.test(value) && rules.digit.test(value);
        };

        newPasswordInput.addEventListener('input', evaluateStrength);
    })();
</script>
