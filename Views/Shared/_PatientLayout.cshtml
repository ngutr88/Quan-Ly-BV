@inject QuanLyBenhVien.Data.ApplicationDbContext _dbContext
@{
    Layout = "_Layout";
    var currentPatientUserClaim = User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier);
    var currentPatientUserId = currentPatientUserClaim != null ? int.Parse(currentPatientUserClaim.Value) : 3;
    var unreadNotificationCount = _dbContext.Notifications.Count(n => n.NguoiDungId == currentPatientUserId && !n.DaDoc);

    // Aggregate badge dot for the mobile bottom-nav "Menu" button, which opens
    // the drawer holding Thanh toán/Thông báo/etc. rather than showing each of
    // their individual badges cramped onto one button.
    var currentPatientId = _dbContext.Patients.Where(p => p.NguoiDungId == currentPatientUserId).Select(p => p.Id).FirstOrDefault();
    var unpaidInvoiceCountForBottomNav = _dbContext.Invoices.Count(i => i.ExaminationRecord.Appointment.BenhNhanId == currentPatientId && i.TrangThaiThanhToan == "ChuaThanhToan");
}

<div class="patient-shell text-on-surface overflow-hidden flex h-screen w-full max-w-full">
    <button id="patient-sidebar-backdrop" type="button" aria-label="Đóng menu"
            class="hidden md:hidden fixed inset-0 bg-on-background/40 z-40"
            onclick="closePatientSidebar()"></button>

    <!-- Side Navigation Bar (permanent at md:+, slide-in drawer below it) -->
    <aside id="patient-sidebar" class="patient-sidebar fixed md:relative inset-y-0 left-0 -translate-x-full md:translate-x-0 transition-transform duration-200 ease-out flex flex-col w-[280px] h-screen bg-surface-container-lowest border-r border-outline-variant py-unit-lg shrink-0 z-50">
        <button type="button" aria-label="Đóng menu" onclick="closePatientSidebar()"
                class="md:hidden absolute top-4 right-3 w-9 h-9 flex items-center justify-center rounded-full text-on-surface-variant hover:bg-surface-container-high">
            <span class="material-symbols-outlined">close</span>
        </button>

        <!-- Logo -->
        <div class="px-unit-lg mb-unit-xl">
            <a href="/Patient/Dashboard" class="flex items-center gap-unit-md group">
                <div class="w-10 h-10 bg-primary rounded-xl flex items-center justify-center text-white shadow-sm group-hover:scale-105 transition-transform">
                    <span class="material-symbols-outlined text-white" style="font-variation-settings: 'FILL' 1;">medical_services</span>
                </div>
                <div>
                    <h1 class="font-headline-md text-headline-md font-bold text-primary leading-tight">MediFlow HMS</h1>
                    <p class="text-caption text-on-surface-variant font-semibold">Cổng Bệnh nhân</p>
                </div>
            </a>
        </div>

        @await Component.InvokeAsync("PatientSidebar")

        <!-- Bottom Actions -->
        <div id="patient-sidebar-bottom" class="px-unit-sm mt-auto space-y-1 border-t border-outline-variant pt-unit-sm">
            <a class="flex items-center gap-unit-md px-unit-md py-3 text-on-surface-variant hover:bg-surface-container-low hover:text-on-surface rounded-lg transition-colors font-medium"
               href="/Auth/Logout">
                <span class="material-symbols-outlined">logout</span>
                <span class="font-body-md text-body-md">Đăng xuất</span>
            </a>
        </div>
    </aside>

    <!-- Main Content Area -->
    <main class="flex-1 min-w-0 max-w-full h-screen overflow-x-hidden overflow-y-auto flex flex-col">
        <!-- Top App Bar -->
        <header class="patient-topbar h-16 w-full max-w-full sticky top-0 bg-surface/80 backdrop-blur-md border-b border-outline-variant flex items-center justify-between px-3 md:px-unit-lg gap-1 sm:gap-unit-md shrink-0 z-30">
            <div class="flex items-center gap-unit-sm md:hidden">
                <button type="button" aria-label="Mở menu" onclick="openPatientSidebar()"
                        class="w-9 h-9 flex items-center justify-center rounded-lg text-primary hover:bg-surface-container-high shrink-0">
                    <span class="material-symbols-outlined">menu</span>
                </button>
                <!-- Brand Logo (Mobile Only) -->
                <a href="/Patient/Dashboard" class="flex items-center gap-unit-sm group">
                    <div class="w-9 h-9 bg-primary rounded-xl flex items-center justify-center text-white shadow-sm group-hover:scale-105 transition-transform">
                        <span class="material-symbols-outlined text-[20px]" style="font-variation-settings: 'FILL' 1;">medical_services</span>
                    </div>
                    <div class="flex flex-col">
                        <span class="font-title-lg font-bold text-primary leading-tight">MediFlow</span>
                    </div>
                </a>
            </div>

            <!-- Desktop Welcome Message -->
            <div class="hidden md:flex items-center gap-unit-sm text-on-surface-variant font-medium">
                <span class="material-symbols-outlined text-[18px] text-primary">waving_hand</span>
                <span class="text-body-md">Xin chào, <strong class="text-on-surface">@User.Identity?.Name</strong></span>
            </div>

            <!-- Topbar User Actions (Notifications and Quick Profile) -->
            <div class="flex items-center gap-1 sm:gap-unit-sm shrink-0">
                <!-- Notification Bell -->
                <a href="/Patient/Notification" class="relative flex items-center justify-center p-2 rounded-full hover:bg-surface-container transition-colors text-primary" title="Thông báo">
                    <span class="material-symbols-outlined text-[24px]">notifications</span>
                    @if (unreadNotificationCount > 0)
                    {
                        <span id="header-unread-badge" class="absolute top-1.5 right-1.5 w-4 h-4 bg-error text-white font-semibold text-[10px] rounded-full flex items-center justify-center">
                            @unreadNotificationCount
                        </span>
                    }
                </a>

                <div class="h-8 w-px bg-outline-variant"></div>

                <!-- Static User Profile (dropdown removed as it is redundant) -->
                <div class="flex items-center gap-unit-sm p-1 px-2 rounded-lg">
                    <div class="w-8 h-8 rounded-full bg-primary-fixed flex items-center justify-center text-primary font-bold text-body-md">
                        @(User.Identity?.Name?.Length > 0 ? QuanLyBenhVien.Helpers.NameInitialsHelper.GetInitials(User.Identity.Name) : "B")
                    </div>
                    <span class="hidden sm:inline font-label-md text-label-md text-on-surface">@User.Identity?.Name</span>
                </div>
            </div>
        </header>

        <!-- Main Dynamic Content -->
        <div class="patient-content w-full min-w-0 max-w-full flex-grow shrink-0 overflow-x-clip overflow-y-visible p-margin-mobile md:p-unit-lg pb-24 md:pb-8 flex flex-col">
            @RenderBody()
        </div>

        <!-- Desktop Footer -->
        <footer class="bg-surface-container-low border-t border-outline-variant py-unit-md mt-auto text-center text-caption text-on-surface-variant hidden md:block">
            <div class="max-w-[1280px] mx-auto px-unit-lg flex justify-between items-center">
                <span>© 2026 HMS MediFlow • An toàn &amp; Bảo mật Y tế</span>
                <div class="flex gap-unit-md">
                    <a href="#" class="hover:underline">Điều khoản sử dụng</a>
                    <a href="#" class="hover:underline">Chính sách bảo mật</a>
                </div>
            </div>
        </footer>
    </main>

    <!-- Mobile Navigation Tab Bar (Bottom) - 4 primary links + a Menu button
         that opens the drawer above for everything else (Sổ sức khỏe, Hồ sơ
         người thân, Tài liệu, Thanh toán, Tài khoản, Hỗ trợ...). -->
    <nav class="md:hidden fixed bottom-0 left-0 w-full bg-surface-container-lowest border-t border-outline-variant h-14 flex items-center justify-around z-40 shadow-lg">
        <a href="/Patient/Dashboard" class="flex flex-col items-center gap-0.5 px-3 py-1 rounded-lg transition-colors min-w-[44px] min-h-[44px] justify-center @(ViewContext.RouteData.Values["controller"]?.ToString() == "Dashboard" ? "text-primary" : "text-on-surface-variant hover:text-primary")">
            <span class="material-symbols-outlined text-[22px]" style="@(ViewContext.RouteData.Values["controller"]?.ToString() == "Dashboard" ? "font-variation-settings: 'FILL' 1;" : "")">home</span>
            <span class="text-[10px] font-semibold">Trang chủ</span>
        </a>
        <a href="/Patient/Book" class="flex flex-col items-center gap-0.5 px-3 py-1 rounded-lg transition-colors min-w-[44px] min-h-[44px] justify-center @(ViewContext.RouteData.Values["controller"]?.ToString() == "Book" ? "text-primary" : "text-on-surface-variant hover:text-primary")">
            <span class="material-symbols-outlined text-[22px]" style="@(ViewContext.RouteData.Values["controller"]?.ToString() == "Book" ? "font-variation-settings: 'FILL' 1;" : "")">add_box</span>
            <span class="text-[10px] font-semibold">Đặt lịch</span>
        </a>
        <a href="/Patient/Appointments" class="flex flex-col items-center gap-0.5 px-3 py-1 rounded-lg transition-colors min-w-[44px] min-h-[44px] justify-center @(ViewContext.RouteData.Values["controller"]?.ToString() == "Appointments" ? "text-primary" : "text-on-surface-variant hover:text-primary")">
            <span class="material-symbols-outlined text-[22px]" style="@(ViewContext.RouteData.Values["controller"]?.ToString() == "Appointments" ? "font-variation-settings: 'FILL' 1;" : "")">event_note</span>
            <span class="text-[10px] font-semibold">Lịch hẹn</span>
        </a>
        <a href="/Patient/LabResults" class="flex flex-col items-center gap-0.5 px-3 py-1 rounded-lg transition-colors min-w-[44px] min-h-[44px] justify-center @(ViewContext.RouteData.Values["controller"]?.ToString() == "LabResults" ? "text-primary" : "text-on-surface-variant hover:text-primary")">
            <span class="material-symbols-outlined text-[22px]" style="@(ViewContext.RouteData.Values["controller"]?.ToString() == "LabResults" ? "font-variation-settings: 'FILL' 1;" : "")">biotech</span>
            <span class="text-[10px] font-semibold">Kết quả</span>
        </a>
        <button type="button" onclick="openPatientSidebar()" class="relative flex flex-col items-center gap-0.5 px-3 py-1 rounded-lg transition-colors min-w-[44px] min-h-[44px] justify-center text-on-surface-variant hover:text-primary">
            <span class="material-symbols-outlined text-[22px]">menu</span>
            @if (unreadNotificationCount > 0 || unpaidInvoiceCountForBottomNav > 0)
            {
                <span class="absolute top-0 right-2 w-2 h-2 bg-error rounded-full"></span>
            }
            <span class="text-[10px] font-semibold">Menu</span>
        </button>
    </nav>
</div>

@section Scripts {
    @await RenderSectionAsync("Scripts", required: false)
    <script>
        function openPatientSidebar() {
            document.getElementById('patient-sidebar')?.classList.add('mobile-sidebar-open');
            document.getElementById('patient-sidebar-backdrop')?.classList.remove('hidden');
            document.body.classList.add('overflow-hidden');
        }

        function closePatientSidebar() {
            document.getElementById('patient-sidebar')?.classList.remove('mobile-sidebar-open');
            document.getElementById('patient-sidebar-backdrop')?.classList.add('hidden');
            document.body.classList.remove('overflow-hidden');
        }

        window.addEventListener('resize', () => {
            if (window.innerWidth >= 768) closePatientSidebar();
        });

        // Cùng lý do/khắc phục như syncDoctorSidebarNavPadding() bên khu vực
        // bác sĩ: padding-bottom tĩnh ở site.css nhỏ hơn chiều cao thật của
        // khối "Đăng xuất" cố định phía dưới, khiến mục cuối cùng của nav bị
        // che. Đo thật bằng JS thay vì đoán một con số tĩnh.
        function syncPatientSidebarNavPadding() {
            const nav = document.getElementById('patient-sidebar-nav');
            const bottom = document.getElementById('patient-sidebar-bottom');
            if (!nav || !bottom) return;
            const height = bottom.getBoundingClientRect().height;
            nav.style.paddingBottom = height + 'px';
            nav.style.scrollPaddingBottom = height + 'px';
        }
        document.addEventListener('DOMContentLoaded', syncPatientSidebarNavPadding);
        window.addEventListener('resize', syncPatientSidebarNavPadding);
    </script>
}
@section Styles {
    @await RenderSectionAsync("Styles", required: false)
    <style>
        @@media (max-width: 767px) {
            #patient-sidebar.mobile-sidebar-open {
                transform: translateX(0) !important;
            }
        }
    </style>
}
