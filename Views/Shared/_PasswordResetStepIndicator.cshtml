@model int
@{
    var steps = new[] { "Xác nhận", "Nhập mã", "Mật khẩu mới" };
}
<ol class="flex items-center justify-center gap-2 mb-unit-lg" aria-label="Tiến trình khôi phục mật khẩu">
    @for (var i = 0; i < steps.Length; i++)
    {
        var stepNumber = i + 1;
        var isCurrentOrDone = stepNumber <= Model;
        <li class="flex items-center gap-2">
            <span class="flex items-center justify-center w-7 h-7 rounded-full text-caption font-bold @(isCurrentOrDone ? "bg-primary text-on-primary" : "bg-surface-container-high text-on-surface-variant")">
                @(stepNumber < Model ? "✓" : stepNumber.ToString())
            </span>
            <span class="text-caption font-semibold @(stepNumber == Model ? "text-primary" : "text-on-surface-variant")">@steps[i]</span>
            @if (stepNumber < steps.Length)
            {
                <span class="w-6 h-px bg-outline-variant"></span>
            }
        </li>
    }
</ol>
